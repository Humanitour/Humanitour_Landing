{
  "name": "humanitour",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Plateforme de l'institut de sondage citoyen Humanitour : donnees ouvertes, explorateur de croisements, mediatheque et back-office.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Klaynight-dev/Humanitour_Landing.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "quality:gate": "bun run lint && bun run typecheck && bun run test:coverage",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "bun run prisma/seed.ts",
    "db:permissions": "bun run prisma/sync-permissions.ts",
    "db:studio": "prisma studio",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "services:logs": "docker compose logs -f",
    "setup": "bun run services:up && bun run db:migrate:deploy && bun run db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource/bowlby-one": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "echarts": "^6.1.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "zod": "^4.6.4"
  }
}
