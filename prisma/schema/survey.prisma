// Domaine sondage.
//
// Un sondage n'est pas un type TypeScript : c'est une ligne qui porte son propre
// schema de questions. Creer une enquete ne produit aucun diff (CLAUDE.md).
//
// La decision structurante est `Answer.modalityKey`. Toute reponse, quel que soit
// son type — choix, echelle, nombre, non-reponse — se resout en une cle de modalite
// au moment de l'ecriture. L'agregation ne groupe que par cette cle et n'a donc
// aucun cas particulier a traiter : c'est le « pointeur indirect » de Torvalds
// applique a la non-reponse (AGENTS.md section 1.2).
//
// CANAL UNIQUE : depuis la revision de la decision 3, les reponses n'entrent que
// par Openforms (`forms.humanitour.fr`). Plus de depot de fichier, plus de saisie
// manuelle, plus d'API d'ingestion — donc plus de colonne disant par quel tuyau
// une reponse est arrivee : il n'y en a qu'un. Supprimer ce cas particulier
// plutot que de le brancher, c'est la regle du bon gout appliquee a la collecte.

enum SurveyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Ce qui a declenche une synchronisation. Sert au journal, pas au calcul : une
/// reponse arrivee par le webhook vaut exactement une reponse arrivee par la
/// minuterie.
enum SyncTrigger {
  MANUAL // bouton du back-office
  SCHEDULED // minuterie interne
  WEBHOOK // notification envoyee par Openforms a chaque soumission
  SUBMISSION // reponse deposee depuis /repondre, reprise dans la foulee
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model Survey {
  id       String  @id @default(cuid())
  /// Segment d'URL publique. Fait partie du contrat de permalien : jamais renomme.
  slug     String  @unique
  title    String
  subtitle String?

  /// Contexte editorial affiche en tete de la page publique.
  description String?

  /// Methodologie publiee : mode de collecte, construction de l'echantillon,
  /// limites connues. Obligatoire avant publication, verifie applicativement.
  methodology String?

  status      SurveyStatus @default(DRAFT)
  publishedAt DateTime?

  /// Periode de terrain, affichee avec chaque resultat.
  fieldworkStart DateTime?
  fieldworkEnd   DateTime?

  /// Surcharge locale du seuil de k-anonymat. `null` applique le reglage global
  /// (AppSetting `anonymity.k`, defaut 5).
  kAnonymityThreshold Int?

  // --- Liaison Openforms --------------------------------------------------
  //
  // Le formulaire distant est la SOURCE de la collecte ; cette base en est le
  // miroir publie. Un sondage sans liaison n'a aucun moyen de recevoir des
  // reponses : c'est voulu, et la fiche du back-office le dit.

  /// Identifiant du formulaire chez Openforms. Unique : deux enquetes ne peuvent
  /// pas se disputer le meme formulaire, ce qui dupliquerait chaque reponse a la
  /// synchronisation.
  openformsFormId String? @unique

  /// Slug public du formulaire distant. Sert a servir le questionnaire sur
  /// `/repondre/<slug de l'enquete>` sans rappeler Openforms pour resoudre
  /// l'identifiant a chaque visite.
  openformsSlug String?

  /// Fin de la derniere synchronisation reussie. `null` = jamais synchronise.
  openformsSyncedAt DateTime?

  /// Cles des champs distants ecartes au back-office : la reprise du
  /// questionnaire ne les recree pas, et la proposition de correspondance ne
  /// les suggere plus. Un champ ecarte reste nomme a l'ecran de liaison, et se
  /// retablit d'un bouton : on retire du perimetre, on ne cache pas.
  openformsIgnoredKeys String[] @default([])

  // Etat de collecte, recopie d'Openforms a chaque synchronisation. Il est
  // MIROIR et non source : c'est Openforms qui accepte ou refuse une reponse.
  // Ces colonnes ne servent qu'a afficher « en cours » ou « clos » sans
  // dependre de sa disponibilite.

  /// `Form.isPublished` chez Openforms : le formulaire accepte-t-il des reponses.
  openformsOpen Boolean @default(false)

  /// `Form.startsAt` et `Form.endsAt` chez Openforms. Distincts de la periode de
  /// terrain, qui est une declaration editoriale, la ou celles-ci sont une regle
  /// appliquee par le serveur distant.
  opensAt  DateTime?
  closesAt DateTime?

  /// `Form.maxResponses` chez Openforms. `null` = pas de quota.
  maxResponses Int?

  // --- Fiche du jeu de donnees -------------------------------------------
  //
  // Ce qu'un reutilisateur doit savoir AVANT de telecharger : sur qui porte
  // l'enquete, comment elle a ete collectee, si elle sera mise a jour. Un jeu
  // de donnees sans ces informations se telecharge, mais ne se cite pas.

  /// Themes et mots-cles. Filtrables dans le catalogue public.
  keywords String[] @default([])

  /// Perimetre couvert : « France metropolitaine, treize regions ».
  geographicCoverage String?

  /// Mode de collecte declare : « face-a-face sur le terrain ». Dit comment
  /// l'entretien a ete mene, pas par quel tuyau la reponse est entree en base —
  /// il n'y en a plus qu'un.
  collectionMode String?

  /// Frequence de mise a jour annoncee, ou son absence assumee.
  updateFrequency String?

  // --- Referencement et partage ------------------------------------------

  /// Titre de referencement, s'il doit differer du titre affiche.
  metaTitle String?

  /// Description de referencement et de partage. A defaut, le sous-titre sert.
  metaDescription String?

  questions Question[]
  responses Response[]
  syncs     OpenformsSync[]
  cards     SurveyCard[]
  weighting SurveyWeighting?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([openformsOpen, status])
}

model Question {
  id       String @id @default(cuid())
  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  /// Identifiant stable utilise dans les permaliens de croisement
  /// (`?x=priorite&y=region`). Fait partie du contrat : jamais renomme.
  code     String
  position Int

  /// Libelle exact pose sur le terrain. Affiche avec chaque graphique, parce que
  /// la formulation fait partie du resultat.
  label String
  help  String?

  /// Cle du registre `src/lib/shared/questions/`. Ajouter un type de question
  /// n'ajoute pas de colonne ici.
  type String

  /// Cle du champ correspondant dans le schema Openforms.
  ///
  /// La correspondance vit ICI, sur la question, et non dans un lot d'import :
  /// elle est etablie une fois a la liaison du formulaire, puis toute
  /// synchronisation ulterieure la reutilise. Une question sans cle n'est
  /// simplement jamais alimentee, et le back-office le signale.
  openformsKey String?

  /// Parametres propres au type : bornes d'une echelle, unite, tranches de
  /// regroupement d'un nombre. Valide par le registre.
  config Json @default("{}")

  /// Les questions en texte libre ne sont pas croisables : trop de modalites, et
  /// risque de reidentification.
  isCrossable Boolean @default(true)

  options QuestionOption[]
  answers Answer[]

  @@unique([surveyId, code])
  @@unique([surveyId, openformsKey])
  @@index([surveyId, position])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// Cle de modalite stable, reprise telle quelle dans `Answer.modalityKey`.
  code     String
  label    String
  position Int

  /// « Sans opinion », « refus de repondre », « ne se prononce pas ».
  /// Marquee, jamais exclue : le calcul la compte comme les autres, seul
  /// l'affichage peut la mettre en retrait (AGENTS.md section 1.2).
  isNonResponse Boolean @default(false)

  /// Couleur imposee (nuance politique, par exemple). A defaut, la palette
  /// categorielle du registre de visualisation s'applique.
  color String?

  answers Answer[]

  @@unique([questionId, code])
  @@index([questionId, position])
}

model Response {
  id       String @id @default(cuid())
  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  /// Date de la soumission chez Openforms, pas de la synchronisation : c'est
  /// elle qui porte les courbes.
  collectedAt DateTime

  /// Identifiant de la soumission chez Openforms.
  ///
  /// OBLIGATOIRE, parce que toute reponse vient desormais de la. C'est lui qui
  /// rend la synchronisation idempotente : la rejouer n'ajoute rien, et un
  /// webhook envoye deux fois n'insere pas deux fois le meme repondant. Jamais
  /// affiche.
  externalRef String

  /// Synchronisation qui a insere cette reponse. `SetNull` : purger le journal
  /// des synchronisations ne doit pas emporter les reponses publiees.
  syncId String?
  sync   OpenformsSync? @relation(fields: [syncId], references: [id], onDelete: SetNull)

  /// Poids de redressement, ecrit par le dernier calage (`SurveyWeighting`).
  /// `null` = jamais calcule, ou arrivee apres le dernier calcul : le calage est
  /// alors perime, et la lecture redressee n'est plus proposee au public.
  weight Float?

  answers Answer[]

  createdAt DateTime @default(now())

  @@unique([surveyId, externalRef])
  @@index([surveyId, collectedAt])
}

model Answer {
  id         String   @id @default(cuid())
  responseId String
  response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// Renseigne pour les questions a choix. `null` pour un nombre ou un texte.
  optionId String?
  option   QuestionOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  valueNumber Float?
  valueText   String?
  valueDate   DateTime?

  /// TOUJOURS renseignee, y compris pour une non-reponse. Seule colonne lue par
  /// l'agregation. C'est ce qui supprime le cas particulier plutot que de le
  /// brancher.
  modalityKey String

  @@index([questionId, modalityKey])
  @@index([responseId])
}

/// Journal d'une synchronisation Openforms.
///
/// Remplace l'ancien `ImportBatch` : il n'y a plus de fichier depose, donc plus
/// de nom de fichier, de format ni de correspondance de colonnes a conserver. Ce
/// qui reste utile est ce qui permet de repondre a « pourquoi ce chiffre a
/// bouge » : quand, declenche par quoi, combien de soumissions lues, combien
/// inserees, combien refusees et pour quelle raison.
model OpenformsSync {
  id       String @id @default(cuid())
  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  trigger SyncTrigger
  status  SyncStatus  @default(RUNNING)

  /// Soumissions renvoyees par Openforms, avant tout filtrage.
  fetchedCount Int @default(0)

  /// Reponses reellement inserees. Les soumissions deja connues n'y sont pas.
  createdCount Int @default(0)

  /// Soumissions refusees par la normalisation, avec leur motif dans `errors`.
  rejectedCount Int @default(0)

  /// Adresses ajoutees a `NewsletterSubscriber` depuis un champ email du
  /// formulaire, s'il en a un. Sans lien vers `Response` : voir newsletter.prisma.
  newsletterCount Int @default(0)

  /// Motifs de refus, soumission par soumission. Une synchronisation ne masque
  /// jamais un rejet, exactement comme l'import de fichiers ne le faisait pas.
  errors Json @default("[]")

  /// Message d'echec, lisible par un operateur. `null` si la passe a reussi.
  message String?

  triggeredById String?
  triggeredBy   User?   @relation(fields: [triggeredById], references: [id], onDelete: SetNull)

  responses Response[]

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([surveyId, startedAt])
}

/// Redressement d'une enquete : les marges cibles saisies par un analyste, et le
/// diagnostic du dernier calage (`src/lib/server/survey/weighting.ts`).
///
/// Une ligne par enquete. L'historique des versions vit dans le journal d'audit,
/// qui recoit les cibles et le diagnostic complets a chaque calcul.
model SurveyWeighting {
  surveyId String @id
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  /// Variables de calage : `[{ questionCode, targets: { modalityKey: part } }]`.
  /// Les parts sont entre 0 et 1, normalisees a l'enregistrement.
  variables Json @default("[]")

  /// Origine des marges, publiee avec les chiffres : « Insee, recensement 2021 ».
  source String?

  minWeight Float @default(0.2)
  maxWeight Float @default(5)

  /// Incremente a chaque calcul. Affiche en public : « redressement v3 ».
  version Int @default(0)

  /// Diagnostic du dernier calage. `null` = jamais calcule.
  diagnostics  Json?
  computedAt   DateTime?
  computedById String?
  computedBy   User?     @relation(fields: [computedById], references: [id], onDelete: SetNull)

  /// La lecture redressee est-elle proposee au public ? Jamais par defaut, et
  /// meme publiee, la lecture brute reste celle qu'on affiche en premier.
  isPublished Boolean   @default(false)
  publishedAt DateTime?

  updatedAt DateTime @updatedAt
}

/// Carte de visualisation publiee par le back-office : un croisement fige,
/// editorialise, affiche sur la page publique du sondage. Le visiteur peut
/// l'ouvrir dans l'explorateur pour en changer les axes.
model SurveyCard {
  id       String @id @default(cuid())
  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  title    String
  comment  String?
  position Int     @default(0)

  /// Cle du registre `src/lib/charts/`.
  chart String

  /// Codes de question portant les axes. `yCode` absent = distribution simple.
  xCode String
  yCode String?

  /// Filtres appliques, au meme format que les parametres d'URL de l'explorateur.
  filters Json @default("{}")

  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([surveyId, position])
}
