// Domaine planning.
//
// Le planning du back-office montre sur un meme calendrier ce qui existe deja
// ailleurs (publications de medias, terrains et ouvertures d'enquetes,
// campagnes d'infolettre) et ce qui n'existe nulle part ailleurs : les rendez-
// vous de l'equipe, ses taches et qui est disponible. Seuls ces trois derniers
// ont une table ici. Les autres sont LUS dans leur domaine, jamais recopies :
// une date de publication tenue a deux endroits finirait par en avoir deux.

enum PlanningEventKind {
  /// Une publication prevue qui n'a pas (encore) de media : post, communique.
  EDITORIAL
  MEETING
  /// Une sortie de terrain : collecte, rencontre, deplacement.
  FIELD
  OTHER
}

enum PlanningTaskStatus {
  TODO
  DOING
  DONE
}

enum AvailabilityKind {
  /// Disponible, sur place ou en deplacement pour l'association.
  PRESENT
  ABSENT
}

model PlanningEvent {
  id    String            @id @default(cuid())
  title String
  kind  PlanningEventKind  @default(OTHER)
  note  String?

  /// Canal de diffusion d'un evenement editorial : Instagram, presse, infolettre.
  channel String?

  /// Jour (et heure, sauf journee entiere) de debut.
  startsAt DateTime
  /// Fin, `null` pour un evenement ponctuel.
  endsAt   DateTime?
  allDay   Boolean   @default(true)

  createdById String?
  createdBy   User?   @relation("PlanningEventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt])
}

model PlanningTask {
  id     String             @id @default(cuid())
  title  String
  note   String?
  status PlanningTaskStatus @default(TODO)

  /// Echeance, au jour. `null` : a faire, sans date.
  dueOn DateTime? @db.Date

  assigneeId String?
  assignee   User?   @relation("PlanningTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("PlanningTaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, dueOn])
  @@index([assigneeId])
}

/// Une periode de presence ou d'absence d'un membre, bornes incluses.
model TeamAvailability {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation("TeamAvailabilityUser", fields: [userId], references: [id], onDelete: Cascade)
  kind   AvailabilityKind

  startsOn DateTime @db.Date
  endsOn   DateTime @db.Date
  note     String?

  createdAt DateTime @default(now())

  @@index([startsOn, endsOn])
  @@index([userId])
}
